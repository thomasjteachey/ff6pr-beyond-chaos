<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PrGame>ff6</PrGame>
    <AssemblyName>BeyondChaos.PR</AssemblyName>
    <PrKitSeeds>true</PrKitSeeds>   <!-- the kit's seed system (PrKit/Seeds): flags, screen, generator, seed library -->
    <PrKitSnes>true</PrKitSnes>     <!-- the kit's SNES music player (PrKit/Snes): BC's songs (BcMusic.cs) -->
  </PropertyGroup>
  <!-- the modding kit (plugin/PrKit) and the game's BepInEx + interop references; GameDir comes from
       plugin/PrKit/Games.props. PrKit beside this plugin (the project), else the kit/ submodule (its repo). -->
  <PropertyGroup>
    <KitProps>$(MSBuildThisFileDirectory)..\PrKit\PrKit.props</KitProps>
    <KitProps Condition="!Exists('$(KitProps)')">$(MSBuildThisFileDirectory)..\..\..\kit\pr\plugin\PrKit\PrKit.props</KitProps>
  </PropertyGroup>
  <Import Project="$(KitProps)" />
  <ItemGroup>
    <None Include="bc_flags.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- dotnet build -c Release -p:Deploy=true  (the game closed): the plugin folder only; the generator,
       baseline and Magicite folder come from tools/bc_bundle.py (kit.py deploy bc) -->
  <Target Name="Deploy" AfterTargets="Build" Condition="'$(Deploy)' == 'true'">
    <Copy SourceFiles="$(TargetPath);bc_flags.json" DestinationFolder="$(GameDir)\BepInEx\plugins\BeyondChaos" />
  </Target>
</Project>
