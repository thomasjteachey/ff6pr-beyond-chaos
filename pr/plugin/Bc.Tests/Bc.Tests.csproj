<Project Sdk="Microsoft.NET.Sdk">
  <!-- Offline tests for the Beyond Chaos flags on the kit's flag model (PrKit/Seeds/Flags.cs, BC's
       "name:value" style). No game, no NuGet packages. From this folder:
         dotnet run -c Release [bc_flags.json] [out.tsv]
       then tests/test_bc.py checks every string against BC's own options parser. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <RollForward>Major</RollForward>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!-- the kit's flag model: PrKit beside this folder (the project), else the kit/ submodule (the mod's repo) -->
    <Compile Include="..\PrKit\Seeds\Flags.cs" Condition="Exists('..\PrKit\Seeds\Flags.cs')" />
    <Compile Include="..\..\..\kit\pr\plugin\PrKit\Seeds\Flags.cs" Condition="!Exists('..\PrKit\Seeds\Flags.cs')" />
  </ItemGroup>
</Project>
