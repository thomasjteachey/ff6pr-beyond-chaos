<Project Sdk="Microsoft.NET.Sdk">
  <!-- Offline tests for Beyond Chaos's game-free rules: the battle side's (bc-battle: plugin/BcPlugin/BcBattleRules.cs)
       and strangejourney's per-world doors (plugin/BcPlugin/BcDoorRules.cs). No game, no NuGet packages.
       From this folder: dotnet run -c Debug [SEED/bc_doors.json after a double dash]  (exit 0 = all passed; a seed's
       bc_doors.json, tools/bc_entrances.py apply's, is checked too when given) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <RollForward>Major</RollForward>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\BcPlugin\BcBattleRules.cs" />
    <Compile Include="..\BcPlugin\BcDoorRules.cs" />
  </ItemGroup>
</Project>
