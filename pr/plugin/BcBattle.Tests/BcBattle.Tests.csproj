<Project Sdk="Microsoft.NET.Sdk">
  <!-- Offline tests for Beyond Chaos's game-free battle rules (bc-battle: plugin/BcPlugin/BcBattleRules.cs).
       No game, no NuGet packages. From this folder: dotnet run -c Debug  (exit 0 = all passed) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <RollForward>Major</RollForward>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\BcPlugin\BcBattleRules.cs" />
  </ItemGroup>
</Project>
